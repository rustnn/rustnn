	[operand_860] = reshape(weight_245, newShape=[1, 128, 1, 1]);
	[operand_861] = mul(operand_859, operand_860);
	[operand_862] = reshape(weight_246, newShape=[1, 128, 1, 1]);
	[operand_850] = add(operand_861, operand_862);
	[operand_863] = sigmoid(operand_850);
	[operand_864] = mul(operand_850, operand_863);
	[operand_866] = reshape(weight_248, newShape=[1, 3, 1, 1]);
	[operand_867] = conv2d(operand_864, weight_247, filterLayout="oihw", groups=1, inputLayout="nchw", padding=[1, 1, 1, 1]);
	[operand_865] = add(operand_867, operand_866);
  }
  outputs { operand_865; }
}
